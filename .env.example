# Sito rassegna: press. Secondo progetto Vercel: news.
JUMP_SITE=press
JUMP_PUBLIC_URL=http://127.0.0.1:3015
# Repository DATI privato, separato dal codice, inizializzato con content-template/index.json.
JUMP_CONTENT_REPO=
JUMP_CONTENT_BRANCH=main
# Fine-grained PAT: Metadata read + Contents read/write solo sul repository dati.
JUMP_GITHUB_TOKEN=
# OAuth App GitHub per il login; callback: <JUMP_PUBLIC_URL>/api/auth/callback
JUMP_GITHUB_CLIENT_ID=
JUMP_GITHUB_CLIENT_SECRET=
# JSON: ID numerico GitHub (non username) -> publisher, editor oppure producer.
JUMP_GITHUB_MEMBERS={}
# Almeno 32 caratteri casuali. Solo server, mai NEXT_PUBLIC.
JUMP_SESSION_SECRET=
# Blob PRIVATO collegato al progetto press. Vercel può usare OIDC con BLOB_STORE_ID.
BLOB_STORE_ID=
# Alternativa per sviluppo locale / store con token:
BLOB_READ_WRITE_TOKEN=
# Ricevitore alert senza dati personali:
JUMP_ALERT_WEBHOOK_URL=
# Solo progetto News, se usato:
X_BEARER_TOKEN=
